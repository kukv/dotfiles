# Managed by mise [dotfiles] — edit home/dot_ssh/config.tera in kukv/dotfiles
# Machine-local, untracked overrides go in ~/.ssh/config.local
{%- if vars.use_1password == "true" %}

Include ~/.ssh/1Password/config
{%- endif %}

# First match wins in ssh_config, so the local file comes before the hosts below.
Include ~/.ssh/config.local

Host github
  HostName github.com
  Port 22
  User git
{%- if vars.use_1password == "true" %}

Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{%- endif %}
