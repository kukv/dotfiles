{{- $isWSL := (index .chezmoi.kernel "osrelease" | default "" | lower | contains "microsoft") -}}
{{- /* use_1password may be injected by os-setup; default to 1Password when absent (chezmoi runs missingkey=error) */ -}}
{{- $op := true -}}
{{- if hasKey . "use_1password" }}{{ $op = .use_1password }}{{ end -}}
# Managed by chezmoi — edit with: chezmoi edit ~/.gitconfig
[user]
    name = {{ .git_name }}
    email = {{ .git_email }}
{{- if $op }}
    # 1Password resolves the key from the agent (single vault), so no key is pinned here.
    signingkey =
{{- else }}
    signingkey = {{ index . "git_signing_key_file" | default (printf "%s/.ssh/id_ed25519.pub" .chezmoi.homeDir) }}
{{- end }}
[core]
    quotepath = false
{{- if $isWSL }}
    # WSL: route git's ssh through the Windows host, where the SSH agent (1Password or Windows OpenSSH) holds the key.
    # Detect via the kernel string — .chezmoi.os is "linux" on native Linux too.
    sshCommand = ssh.exe
{{- end }}
[ghq]
    root = {{ .chezmoi.homeDir }}/dev/ghq
[color]
    ui = auto
[gpg]
    format = ssh
[gpg "ssh"]
{{- if $op }}
{{- if eq .chezmoi.os "darwin" }}
    program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
{{- else if $isWSL }}
    # WSL: resolved via the Windows PATH (WSL interop), same mechanism as ssh.exe above
    program = op-ssh-sign-wsl.exe
{{- end }}
{{- else }}
    # No 1Password: verify local-key signatures against this file (generated by chezmoi).
    allowedSignersFile = {{ .chezmoi.homeDir }}/.ssh/allowed_signers
{{- end }}
[commit]
    gpgsign = true
[tag]
    gpgsign = true
