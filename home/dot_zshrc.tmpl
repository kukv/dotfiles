# Managed by chezmoi — edit with: chezmoi edit ~/.zshrc
# Machine-local, untracked overrides go in ~/.zshrc.local

# ==========================================================================
# = Oh-My-Zsh
# ==========================================================================
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="alien/alien"

plugins=(
    git
    zsh-syntax-highlighting
    zsh-completions
    zsh-autosuggestions
    zsh-history-substring-search
)

fpath+=$ZSH/custom/plugins/zsh-completions/src
autoload -U compinit && compinit

source $ZSH/oh-my-zsh.sh

# ==========================================================================
# = Oh-My-Zsh theme (alien)
# ==========================================================================
export ALIEN_SECTIONS_LEFT=(
    time
    user
    path
    ssh
    venv
    vcs_branch:async
    vcs_status:async
    vcs_dirty:async
    exit
    newline
    prompt
)
export ALIEN_SECTION_TIME_FORMAT="%Y-%m-%d %H:%M:%S"
export ALIEN_SECTION_USER_HOST=1
export ALIEN_THEME="blue"
{{- if eq .chezmoi.os "darwin" }}
export ALIEN_USE_NERD_FONT=1
{{- end }}
{{ if eq .chezmoi.os "darwin" }}
{{- /* use_1password may be injected by os-setup; default to 1Password when absent (chezmoi runs missingkey=error) */ -}}
{{- $op := true -}}
{{- if hasKey . "use_1password" }}{{ $op = .use_1password }}{{ end -}}
{{- if $op }}
# ==========================================================================
# = 1Password SSH agent (macOS)
# ==========================================================================
export SSH_AUTH_SOCK=~/Library/Group\ Containers/2BUA8C4S2C.com.1password/t/agent.sock
{{ end }}
# ==========================================================================
# = Docker completions (macOS)
# ==========================================================================
fpath=(${HOME}/.docker/completions $fpath)
{{- end }}

# ==========================================================================
# = mise
# ==========================================================================
eval "$(mise activate zsh)"

# ==========================================================================
# = peco
# ==========================================================================
function peco-select-history() {
    local tac
    if which tac > /dev/null; then
        tac="tac"
    else
        tac="tail -r"
    fi
    BUFFER=$(\history -n 1 | \
        eval $tac | \
        peco --query "$LBUFFER")
    CURSOR=$#BUFFER
    zle clear-screen
}
zle -N peco-select-history
bindkey '^r' peco-select-history

function peco-src() {
    local selected_dir=$(ghq list -p | peco --prompt="repositories >" --query "$LBUFFER")
    if [ -n "$selected_dir" ]; then
        BUFFER="cd '${selected_dir}'"
        zle accept-line
    fi
    zle clear-screen
}
zle -N peco-src
bindkey '^]' peco-src

# ==========================================================================
# = aliases
# ==========================================================================
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias history='history -f'
alias relogin='exec $SHELL -l'
alias reload='source ~/.zshrc'
alias cls='clear'
alias cdh='cd ~'
alias v='nvim'
alias cc='claude'
alias ccw='claude -w'
{{- if eq .chezmoi.os "darwin" }}
# provision this machine now (kukv/os-setup launchd wrapper; ~/.local/bin is on PATH)
alias update_os='os-setup-pull.sh'
{{- else if eq .chezmoi.os "linux" }}
# provision this machine now (kukv/os-setup systemd service; root-owned unit)
alias update_os='sudo systemctl start os-setup.service'
{{- end }}
{{- if (index .chezmoi.kernel "osrelease" | default "" | lower | contains "microsoft") }}

# WSL only: route ssh through the Windows host (1Password lives on the Windows side).
# Detect via the kernel string — .chezmoi.os is "linux" on native Linux too.
alias ssh='ssh.exe'
alias ssh-add='ssh-add.exe'
alias scp='scp.exe'
{{- end }}

# ==========================================================================
# = Zsh history
# ==========================================================================
HISTSIZE=1000
SAVEHIST=2000
HISTFILE=$HOME/.zsh_history
setopt extended_history

# ==========================================================================
# = Machine-local overrides (untracked)
# ==========================================================================
[ -f ~/.zshrc.local ] && source ~/.zshrc.local
