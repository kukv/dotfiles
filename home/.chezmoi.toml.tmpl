{{- $name := promptStringOnce . "git_name" "Git user.name" -}}
{{- $email := promptStringOnce . "git_email" "Git user.email" -}}
{{- /* signing key is needed on both macOS and WSL/Linux (1Password commit signing) */ -}}
{{- $signingKey := promptStringOnce . "git_signing_key" "Git signing SSH public key (1Password)" -}}
[data]
    git_name = {{ $name | quote }}
    git_email = {{ $email | quote }}
    git_signing_key = {{ $signingKey | quote }}
